# --- Raw source captures -------------------------------------------------------
# Full-resolution BIG kab/kota polygon pages (SRC-0001) total ~2.2 GB: too large for Git.
# They stay on disk as the immutable raw source; their .meta.json sidecars (URL, sha256,
# bytes, retrieved_at) ARE committed, so every page can be re-fetched and verified.
data/raw/SRC-0001/**/kabkota_geom_*.geojson

# --- Regenerable caches --------------------------------------------------------
data/processed/geography/*/fullres_region_metrics.json
data/processed/geography/*/fullres_parts.json
data/processed/geography/*/render/_join/

# --- Local tooling (reinstall with: npm ci --prefix tools/geo --cache tools/geo/.npm-cache) ---
tools/geo/node_modules/
tools/geo/.npm-cache/

# --- OS / editor / Python ------------------------------------------------------
.DS_Store
__pycache__/
*.pyc
