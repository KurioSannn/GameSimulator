# Local toolchain (Godot editor, node tools) — reproducible via docs/TECHNICAL_ARCHITECTURE.md
tools/*
# ...except the pinned manifest of the geography toolchain (mapshaper, earcut); reinstall with
# npm ci --prefix tools/geo --cache tools/geo/.npm-cache  (docs/29_GEOGRAPHY_DATA_PIPELINE.md)
!tools/geo/
tools/geo/*
!tools/geo/package.json
!tools/geo/package-lock.json
# Regenerable caches of the geography v2 pipeline
data/processed/geography/*/fullres_region_metrics.json
data/processed/geography/*/fullres_parts.json
data/processed/geography/*/render/_join/
# Large immutable raw captures: checksums are committed in data/raw/**/MANIFEST.json
data/raw/**/features/
data/raw/**/*.geojson
# Godot
game/.godot/
game/export/
*.import.tmp
# OS / editor
.DS_Store
__pycache__/
*.pyc
.venv/
# Secrets
.env
*.key
data/raw/**/*.sql
data/processed/**/*.geojson
data/raw/**/*.pdf
