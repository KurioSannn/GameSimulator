{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "policy",
 "type": "object",
 "required": [
  "schema",
  "policy_id",
  "name",
  "category",
  "description",
  "fact_class",
  "provenance",
  "target_scope",
  "cost",
  "implementation_months",
  "duration_months",
  "cooldown_months",
  "prerequisites",
  "mutually_exclusive",
  "uncertainty",
  "effects",
  "game_design_notes"
 ],
 "properties": {
  "policy_id": {
   "type": "string",
   "pattern": "^POL-[A-Z0-9-]+$"
  },
  "name": {
   "type": "string"
  },
  "category": {
   "type": "string"
  },
  "fact_class": {
   "enum": [
    "FICTIONAL",
    "DERIVED"
   ]
  },
  "provenance": {
   "type": "object",
   "required": [
    "basis",
    "references"
   ],
   "properties": {
    "basis": {
     "enum": [
      "game_design",
      "real_programme_inspired"
     ]
    },
    "references": {
     "type": "array"
    }
   }
  },
  "target_scope": {
   "type": "array",
   "minItems": 1,
   "items": {
    "enum": [
     "national",
     "island_group",
     "province",
     "kabkota",
     "selected"
    ]
   }
  },
  "target_filter": {
   "type": "string",
   "pattern": "^[a-z_]+(>=|<=|>|<)-?[0-9.]+$"
  },
  "cost": {
   "type": "object",
   "required": [
    "upfront_fiscal",
    "monthly_commitment",
    "commitment_months"
   ],
   "properties": {
    "upfront_fiscal": {
     "type": "number",
     "minimum": 0
    },
    "monthly_commitment": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "commitment_months": {
     "type": "integer",
     "minimum": 0
    }
   }
  },
  "implementation_months": {
   "type": "integer",
   "minimum": 0
  },
  "duration_months": {
   "type": "integer",
   "minimum": 1
  },
  "cooldown_months": {
   "type": "integer",
   "minimum": 0
  },
  "prerequisites": {
   "type": "object"
  },
  "mutually_exclusive": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^POL-"
   }
  },
  "uncertainty": {
   "type": "object",
   "required": [
    "magnitude"
   ],
   "properties": {
    "magnitude": {
     "type": "number",
     "minimum": 0,
     "maximum": 0.9
    }
   }
  },
  "effects": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "phase",
     "scope",
     "var",
     "op",
     "value",
     "kind",
     "dimension",
     "label"
    ],
    "properties": {
     "phase": {
      "enum": [
       "immediate",
       "implementation",
       "active"
      ]
     },
     "scope": {
      "type": "string",
      "pattern": "^(target|national)$"
     },
     "var": {
      "type": "string"
     },
     "op": {
      "enum": [
       "add",
       "mul",
       "set"
      ]
     },
     "value": {
      "type": "number"
     },
     "delay": {
      "type": "integer",
      "minimum": 0
     },
     "duration": {
      "type": "integer",
      "minimum": 1
     },
     "kind": {
      "enum": [
       "expected",
       "delayed"
      ]
     },
     "dimension": {
      "enum": [
       "regional",
       "national",
       "stakeholder",
       "sentiment",
       "environmental",
       "fiscal"
      ]
     },
     "label": {
      "type": "string",
      "minLength": 5
     },
     "scale_by": {
      "type": "object",
      "required": [
       "var",
       "mode"
      ],
      "properties": {
       "var": {
        "type": "string"
       },
       "mode": {
        "enum": [
         "capacity",
         "gap"
        ]
       },
       "ref": {
        "type": "number"
       },
       "min": {
        "type": "number",
        "minimum": 0
       },
       "max": {
        "type": "number",
        "minimum": 0
       }
      },
      "additionalProperties": false
     }
    },
    "additionalProperties": false
   }
  },
  "cultural_basis": {
   "type": [
    "object",
    "null"
   ],
   "required": [
    "culture_record_ref",
    "interpretation",
    "sensitivity_review"
   ],
   "description": "Hook for researched local-wisdom mechanics: must reference research/culture/records/<id>.json with a completed mechanic_mapping and sensitivity review. Null until such research exists."
  },
  "memory": {
   "type": "object"
  },
  "stakeholder_notes": {
   "type": "array"
  },
  "follow_up_case_triggers": {
   "type": "array"
  },
  "game_design_notes": {
   "type": "string"
  },
  "schema": {
   "const": "nusantara.policy/1"
  },
  "description": {
   "type": "string",
   "minLength": 10
  }
 },
 "additionalProperties": false
}