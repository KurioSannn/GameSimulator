{
 "type": "object",
 "required": [
  "schema",
  "case_id",
  "research_ref",
  "research_status",
  "title",
  "trigger",
  "real_context",
  "briefing",
  "choices"
 ],
 "properties": {
  "case_id": {
   "type": "string",
   "pattern": "^CASE-\\d{4}(-[A-Z0-9]+)?$"
  },
  "research_status": {
   "enum": [
    "candidate",
    "researched",
    "cross-checked",
    "validated"
   ]
  },
  "class": {
   "enum": [
    "major_historical",
    "recurring_systemic",
    "secondary_consequence",
    "regional",
    "national"
   ]
  },
  "trigger": {
   "type": "object",
   "required": [
    "type",
    "conditions"
   ],
   "properties": {
    "type": {
     "enum": [
      "condition",
      "scheduled",
      "follow_up"
     ]
    },
    "weight": {
     "type": "number",
     "minimum": 0
    },
    "recurring": {
     "type": "object",
     "required": [
      "cooldown_ticks",
      "max_occurrences"
     ],
     "properties": {
      "cooldown_ticks": {
       "type": "integer",
       "minimum": 1
      },
      "max_occurrences": {
       "type": "integer",
       "minimum": 1
      }
     }
    }
   }
  },
  "real_context": {
   "type": "object",
   "required": [
    "fact_class",
    "lines"
   ],
   "properties": {
    "lines": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "text",
       "source_refs",
       "as_of"
      ],
      "properties": {
       "source_refs": {
        "type": "array",
        "minItems": 1
       }
      }
     }
    },
    "fact_class": {
     "enum": [
      "REAL_OFFICIAL",
      "REAL_ACADEMIC",
      "REAL_NEWS",
      "REAL_SECONDARY",
      "NONE"
     ]
    }
   }
  },
  "briefing": {
   "type": "object",
   "required": [
    "fact_class",
    "text"
   ],
   "properties": {
    "fact_class": {
     "const": "FICTIONAL"
    }
   }
  },
  "on_trigger_effects": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "scope",
     "var",
     "op",
     "value"
    ],
    "properties": {
     "scope": {
      "type": "string",
      "pattern": "^(national|all|region:\\d\\d\\.\\d\\d|province:\\d\\d|regions:\\d\\d\\.\\d\\d(,\\d\\d\\.\\d\\d)*|where:[a-z_]+(>=|<=|>|<)-?[0-9.]+(&in:\\d\\d\\.\\d\\d(,\\d\\d\\.\\d\\d)*)?)$"
     },
     "var": {
      "type": "string"
     },
     "op": {
      "enum": [
       "add",
       "mul",
       "set"
      ]
     },
     "value": {
      "type": "number"
     },
     "delay": {
      "type": "integer",
      "minimum": 0
     },
     "duration": {
      "type": "integer",
      "minimum": 1
     },
     "scale_by": {
      "type": "object",
      "required": [
       "var",
       "mode"
      ],
      "properties": {
       "var": {
        "type": "string"
       },
       "mode": {
        "enum": [
         "capacity",
         "gap"
        ]
       },
       "ref": {
        "type": "number"
       },
       "min": {
        "type": "number",
        "minimum": 0
       },
       "max": {
        "type": "number",
        "minimum": 0
       }
      },
      "additionalProperties": false
     }
    },
    "additionalProperties": false
   }
  },
  "choices": {
   "type": "array",
   "minItems": 2,
   "items": {
    "type": "object",
    "required": [
     "choice_id",
     "label",
     "description",
     "fact_class",
     "effects"
    ],
    "properties": {
     "fact_class": {
      "const": "SIMULATED"
     },
     "effects": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "scope",
        "var",
        "op",
        "value"
       ],
       "properties": {
        "scope": {
         "type": "string",
         "pattern": "^(national|all|region:\\d\\d\\.\\d\\d|province:\\d\\d|regions:\\d\\d\\.\\d\\d(,\\d\\d\\.\\d\\d)*|where:[a-z_]+(>=|<=|>|<)-?[0-9.]+(&in:\\d\\d\\.\\d\\d(,\\d\\d\\.\\d\\d)*)?)$"
        },
        "var": {
         "type": "string"
        },
        "op": {
         "enum": [
          "add",
          "mul",
          "set"
         ]
        },
        "value": {
         "type": "number"
        },
        "delay": {
         "type": "integer",
         "minimum": 0
        },
        "duration": {
         "type": "integer",
         "minimum": 1
        },
        "scale_by": {
         "type": "object",
         "required": [
          "var",
          "mode"
         ],
         "properties": {
          "var": {
           "type": "string"
          },
          "mode": {
           "enum": [
            "capacity",
            "gap"
           ]
          },
          "ref": {
           "type": "number"
          },
          "min": {
           "type": "number",
           "minimum": 0
          },
          "max": {
           "type": "number",
           "minimum": 0
          }
         },
         "additionalProperties": false
        }
       },
       "additionalProperties": false
      }
     },
     "memory": {
      "type": "object"
     },
     "enact_policy": {
      "type": "object",
      "required": [
       "policy_id",
       "target"
      ],
      "properties": {
       "policy_id": {
        "type": "string",
        "pattern": "^POL-"
       },
       "target": {
        "type": "object",
        "required": [
         "type"
        ]
       }
      }
     }
    }
   }
  },
  "simulated_context": {
   "type": "object",
   "required": [
    "fact_class",
    "text"
   ],
   "properties": {
    "fact_class": {
     "const": "SIMULATED"
    }
   }
  },
  "origin_case": {
   "type": "string",
   "pattern": "^CASE-\\d{4}$"
  }
 },
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "case",
 "allOf": [
  {
   "if": {
    "properties": {
     "class": {
      "const": "secondary_consequence"
     }
    }
   },
   "then": {
    "required": [
     "simulated_context",
     "origin_case"
    ],
    "properties": {
     "real_context": {
      "properties": {
       "fact_class": {
        "const": "NONE"
       },
       "lines": {
        "maxItems": 0
       }
      }
     },
     "trigger": {
      "properties": {
       "type": {
        "const": "follow_up"
       }
      }
     }
    }
   }
  }
 ]
}