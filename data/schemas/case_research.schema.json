{
 "type": "object",
 "required": [
  "schema",
  "case_id",
  "title",
  "status",
  "category",
  "start_date",
  "provinces",
  "real_facts",
  "sources",
  "fact_vs_simulation_notes"
 ],
 "properties": {
  "status": {
   "enum": [
    "candidate",
    "researched",
    "cross-checked",
    "validated",
    "rejected"
   ]
  },
  "provinces": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^\\d\\d$"
   }
  },
  "real_facts": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "fact",
     "source_refs",
     "as_of"
    ],
    "properties": {
     "source_refs": {
      "type": "array",
      "minItems": 1
     }
    }
   }
  },
  "sources": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "source_id",
     "institution",
     "title",
     "url",
     "retrieved_at",
     "source_quality"
    ]
   }
  }
 },
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "case_research"
}