; Engine configuration file.
config_version=5

[application]

config/name="NUSANTARA"
config/description="Simulasi pemerintahan 2D berbasis data Indonesia nyata."
run/main_scene="res://src/app/main.tscn"
config/features=PackedStringArray("4.7")
config/version="1.0.2"
config/icon="res://assets/ui/app_icon.png"
config/quit_on_go_back=false
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/image="res://assets/ui/boot_splash.png"
boot_splash/stretch_mode=4
boot_splash/use_filter=true
boot_splash/show_image=false

[autoload]

Updater="*res://src/app/updater.gd"
ContentDB="*res://src/data/content_db.gd"
Game="*res://src/app/game.gd"
GameAudio="*res://src/audio/game_audio.gd"

[display]

window/size/viewport_width=1440
window/size/viewport_height=810
window/size/window_width_override=1600
window/size/window_height_override=900
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[internationalization]

locale/fallback="id"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
